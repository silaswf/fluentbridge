{
  "name": "fluentbridge",
  "private": true,
  "version": "9.1.0",
  "description": "FluentBridge Academy - Plataforma de Ensino em 16 Idiomas (A1-C1)",
  "author": "Prof. Silas - FluentBridge Academy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "exe:build": "npm run build && electron-packager . FluentBridge --platform=win32 --arch=x64 --out=release --overwrite --ignore=^/release --ignore=^/android --ignore=^/ios --ignore=^/\\.github --ignore=^/src",
    "installer:build": "npm run icons && npm run build && electron-builder --win nsis --publish never",
    "apk:init": "npx cap add android",
    "apk:sync": "npm run build && npx cap sync android",
    "release:patch": "npm version patch -m \"chore(release): v%s\" && git push origin main --follow-tags",
    "release:minor": "npm version minor -m \"chore(release): v%s\" && git push origin main --follow-tags",
    "cf:login": "npx wrangler login",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name=fluentbridge --branch=main"
  },
  "build": {
    "appId": "com.fluentbridge.app",
    "productName": "FluentBridge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FluentBridge Academy",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.0.1",
    "@capacitor/local-notifications": "^7.0.7",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@electron/packager": "^18.3.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}